# Copy to .env.local for local dev. Deployed values live in Netlify env vars.

# Supabase — PUBLIC (inlined into the browser bundle at build time).
# From Supabase Dashboard → Project Settings → API. Never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback for older setups:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base URL — SERVER-SIDE only (read at build and request time, not
# exposed to the browser). Deliberately not NEXT_PUBLIC_.
API_URL=http://localhost:8000

# Preparation workspace (P7-T15) — PUBLIC, non-secret, inlined at build time: changing it needs a rebuild.
# Only the exact value "true" turns it on. Off or unset: /prepare is not found and its navigation entry is hidden.
# NEXT_PUBLIC_PREP_ENABLED=true
# The API origin the browser calls for /prepare (P7-D-009) — PUBLIC, non-secret, inlined at build time. Unset: the
# workspace says it is not configured. The API's CORS allow-list must include the site origin (P7-T5).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Practice workspace route (P9-T06) — PUBLIC, non-secret, inlined at build time. Only the exact value "true" lets
# /practice/attempts/* render instead of 404; it enables nothing: the API's PRACTICE_ENABLED, rollout and capability
# answer decide whether practice exists for a caller. Off or unset: those routes are not found for everyone.
# NEXT_PUBLIC_PRACTICE_ENABLED=true
# Practice privacy access (P9-T15) — PUBLIC, non-secret. Only "true" shows /privacy/practice and the Privacy page's link
# to it while the practice flag is off, so learners can still export, delete or withdraw. It opens no practice route.
# NEXT_PUBLIC_PRACTICE_PRIVACY_ACCESS=true

# Catalog preview credential — SERVER-SIDE only, never NEXT_PUBLIC_. Holding it makes this a preview:
# catalog requests send it as X-Preview-Token, and catalog pages show "Preview" and are noindex.
# Same value as the backend's CATALOG_PREVIEW_TOKEN (at least 32 characters). Beta and local only;
# production must leave it unset, and the API refuses it there.
# CATALOG_PREVIEW_TOKEN=

# Homepage read budget (P8 hot path) — SERVER-SIDE, optional, not secret. How long the homepage waits for its two public
# catalog reads, in milliseconds (at least 100), before it shows a pending Tracks section and lets the read finish into the
# cache. Unset: 800 in production, and no budget on a preview (a preview's reads are never cached). "off" always waits.
# HOME_READ_BUDGET_MS=

# Hot-path timing (P8) — SERVER-SIDE, optional, not secret. "off" stops the one JSON timing line written per catalog page
# render (route label, read kinds and numbers only).
# HOTPATH_TIMING=
