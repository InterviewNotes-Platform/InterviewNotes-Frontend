# Copy to .env.local for local dev. Deployed values live in Netlify env vars.

# Supabase — PUBLIC (inlined into the browser bundle at build time).
# From Supabase Dashboard → Project Settings → API. Never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback for older setups:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base URL — SERVER-SIDE only (read at build and request time, not
# exposed to the browser). Deliberately not NEXT_PUBLIC_.
API_URL=http://localhost:8000
