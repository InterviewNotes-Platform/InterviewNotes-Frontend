# Copy to .env.local for local dev. Deployed values live in Netlify env vars.

# Supabase — PUBLIC (inlined into the browser bundle at build time).
# From Supabase Dashboard → Project Settings → API. Never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback for older setups:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base URL — SERVER-SIDE only (read at build and request time, not
# exposed to the browser). Deliberately not NEXT_PUBLIC_.
API_URL=http://localhost:8000

# Preparation workspace (P7-T15) — PUBLIC, non-secret, inlined at build time: changing it needs a rebuild.
# Only the exact value "true" turns it on. Off or unset: /prepare is not found and its navigation entry is hidden.
# NEXT_PUBLIC_PREP_ENABLED=true
# The API origin the browser calls for /prepare (P7-D-009) — PUBLIC, non-secret, inlined at build time. Unset: the
# workspace says it is not configured. The API's CORS allow-list must include the site origin (P7-T5).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Catalog preview credential — SERVER-SIDE only, never NEXT_PUBLIC_. Holding it makes this a preview:
# catalog requests send it as X-Preview-Token, and catalog pages show "Preview" and are noindex.
# Same value as the backend's CATALOG_PREVIEW_TOKEN (at least 32 characters). Beta and local only;
# production must leave it unset, and the API refuses it there.
# CATALOG_PREVIEW_TOKEN=
